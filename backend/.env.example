# Server Configuration (Render sets $PORT automatically)
PORT=8080

# CORS Allowed Origin (Set to your deployed Vercel domain)
FRONTEND_URL=https://your-app-name.vercel.app

# Supabase PostgreSQL Database Credentials
SUPABASE_DB_URL=jdbc:postgresql://your-supabase-db-host:5432/postgres?sslmode=require
SUPABASE_DB_USER=your_database_user
SUPABASE_DB_PASSWORD=your_database_password
